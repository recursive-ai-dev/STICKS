{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["stickman_id", "limb_id", "impulse", "side_effect_trait"],
  "properties": {
    "stickman_id": { "type": "string" },
    "limb_id": { "type": "string", "enum": ["head", "rightArm", "leftArm", "rightLeg", "leftLeg"] },
    "impulse": { "type": "number" },
    "side_effect_trait": { "type": "string" }
  }
}
